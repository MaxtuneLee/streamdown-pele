{
  "name": "streamdown-pele",
  "version": "0.1.0",
  "description": "Render Mermaid diagrams in Streamdown with Pele, a small and fast Mermaid renderer.",
  "keywords": [
    "streamdown",
    "pele",
    "mermaid",
    "diagram",
    "markdown",
    "svg"
  ],
  "license": "MIT",
  "author": "MaxtuneLee",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaxtuneLee/streamdown-pele.git"
  },
  "homepage": "https://github.com/MaxtuneLee/streamdown-pele#readme",
  "bugs": {
    "url": "https://github.com/MaxtuneLee/streamdown-pele/issues"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc",
    "test": "vitest run",
    "prepublishOnly": "tsdown"
  },
  "dependencies": {
    "pele": "^1.6.0"
  },
  "peerDependencies": {
    "streamdown": "^2.4.0"
  },
  "devDependencies": {
    "streamdown": "^2.7.0",
    "tsdown": "^0.23.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
